# ==========================================
# DJANGO CORE (PRODUCTION)
# ==========================================
ENVIRONMENT=production
DEBUG=False
# IMPORTANT: Generate a new key on the server without the symbol $ (for example, through: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=
# Specify real domains separated by commas, without spaces
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# For HTTPS and CSRF to work (strictly with https://)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==========================================
# APP SETTINGS
# ==========================================
APP_VERSION=0.1.0
APP_NAME="Django Starter Prod"
TIME_ZONE=Europe/Moscow
LOG_LEVEL=INFO

# ==========================================
# DATABASE & CACHE
# ==========================================
POSTGRES_DB=django_starter_db_prod
POSTGRES_USER=django_starter_user_prod
POSTGRES_PASSWORD=django_starter_password_prod

# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://django_starter_user_prod:django_starter_password_prod@db:5432/django_starter_db_prod

CACHE_ENABLED=True
REDIS_URL=redis://redis:6379/1
