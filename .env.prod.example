# ==========================================
# DJANGO CORE (PRODUCTION)
# ==========================================
ENVIRONMENT=production
DEBUG=False
# IMPORTANT: Generate a new key on the server without the symbol $ (for example, through: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=
# Specify real domains separated by commas, without spaces
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# For HTTPS and CSRF to work (strictly with https://)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==========================================
# APP SETTINGS
# ==========================================
APP_VERSION=0.1.0
APP_NAME="Django Starter Prod"
TIME_ZONE=Europe/Moscow
LOG_LEVEL=INFO

# ==========================================
# DATABASE & CACHE
# ==========================================
# Come up with a complex password for production!
DATABASE_URL=postgres://prod_user:SUPER_SECRET_PASSWORD@db:5432/prod_db

CACHE_ENABLED=True
REDIS_URL=redis://redis:6379/1
